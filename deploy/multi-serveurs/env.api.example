# =============================================================================
# Variables d'un SERVEUR API — copier en deploy/multi-serveurs/.env.api
# (ce fichier .env.api n'est pas versionné). Le .env habituel de l'API (APP_KEY,
# JWT_SECRET, API_KEY, PAPI, Cloudinary…) reste à la racine, identique partout.
# =============================================================================

# Adresse de CE serveur sur le réseau privé (le répartiteur s'y connecte)
IP_PRIVEE=10.0.0.11

# Adresse privée du serveur de données (PgBouncer 6432, Redis 6379)
IP_DONNEES=10.0.0.10

# Mêmes valeurs que sur le serveur de données
REDIS_PASSWORD=changer-moi-autre-mot-de-passe-long

# Workers Octane : auto = un par cœur (à mesurer avec loadtest/)
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=5000

# Sur UN SEUL serveur API : décommenter pour lancer les tâches planifiées
# COMPOSE_PROFILES=planificateur
