# =============================================================================
# Variables du SERVEUR DE DONNÉES — copier en deploy/multi-serveurs/.env.donnees
# (ce fichier .env.donnees n'est pas versionné)
# =============================================================================

# Adresse de ce serveur sur le réseau PRIVÉ (jamais l'adresse publique)
IP_PRIVEE=10.0.0.10

# Identifiants de la base (les mêmes dans le .env de l'API)
DB_DATABASE=fandrio
DB_USERNAME=fandrio
DB_PASSWORD=changer-moi-mot-de-passe-long

# Mot de passe Redis (le même dans .env.api de chaque serveur API)
REDIS_PASSWORD=changer-moi-autre-mot-de-passe-long

# PostgreSQL (serveur 4 Go de RAM ; à ajuster)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB

# PgBouncer : connexions réellement ouvertes vers PostgreSQL (< PG_MAX_CONNECTIONS)
PGBOUNCER_POOL_SIZE=60
PGBOUNCER_MAX_CLIENT_CONN=3000
